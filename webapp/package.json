{
  "name": "showcase-immobilier-webapp",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check:feat001": "bash scripts/check-feature-001.sh",
    "check:app:types": "bun run --cwd ../codebase-integrity check:app:types",
    "check:app:images": "bun run --cwd ../codebase-integrity check:app:images",
    "check:app:components:no-business-logic": "bun run --cwd ../codebase-integrity check:app:components:no-business-logic",
    "check:app:script-setup-standard": "bun run --cwd ../codebase-integrity check:app:script-setup-standard",
    "check:app:soc": "bun run --cwd ../codebase-integrity check:app:soc",
    "check:app:code-quality": "bun run --cwd ../codebase-integrity check:app:code-quality",
    "check:app:solid": "bun run --cwd ../codebase-integrity check:app:solid",
    "check:app:guards": "bun run --cwd ../codebase-integrity check:app:guards",
    "check:services:no-framework-imports": "bun run --cwd ../codebase-integrity check:services:no-framework-imports",
    "lint:check": "eslint . --max-warnings 0 && bun run --cwd ../codebase-integrity lint",
    "lint:fix": "eslint . --fix && bun run --cwd ../codebase-integrity lint --fix",
    "format:check": "prettier . ../codebase-integrity --check",
    "format:fix": "prettier . ../codebase-integrity --write",
    "quality:check": "bun run lint:check && bun run format:check && bun run type-check",
    "quality:fix": "bun run format:fix && bun run lint:fix",
    "test": "vitest run",
    "test:dashboard": "vitest run server/utils/dashboard/*.vitest.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report .tmp/playwright/report",
    "type-check": "nuxt prepare && vue-tsc --noEmit",
    "setup:local": "bun scripts/setup-local.ts && bun scripts/run-schema-hook.mjs && nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/mdc": "^0.23.1",
    "@nuxtjs/sitemap": "^8.3.4",
    "@scalar/nuxt": "^0.6.63",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-history": "3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "@tiptap/vue-3": "3.30.1",
    "@vueuse/nuxt": "^14.4.0",
    "gsap": "^3.15.0",
    "markdown-it": "^15.0.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-tiptap-editor": "3.4.0",
    "pinia": "^4.0.3",
    "resend": "^6.20.0",
    "tailwindcss": "^4.3.3",
    "vite-svg-loader": "^5.1.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@nuxt/hints": "^1.1.4",
    "@pinia/nuxt": "^1.0.2",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  }
}
