{
  "project": "showcase-immobilier",
  "devPortBase": 19300,
  "publicPortBase": 19400,
  "layers": {
    "web": {
      "branch": "layers/web",
      "role": "Interface publique, contenus et parcours",
      "id": 1,
      "prefix": "WEB",
      "paths": [
        "webapp/sites/",
        "webapp/base/real-estate/",
        "webapp/content/",
        "webapp/public/",
        "webapp/fixtures/",
        "webapp/tests/"
      ]
    },
    "bff": {
      "branch": "layers/bff",
      "role": "Routes et traitements Nitro",
      "id": 2,
      "prefix": "BFF",
      "paths": ["webapp/server/"]
    },
    "domaine": {
      "branch": "layers/domaine",
      "role": "Logique métier et contrats partageables",
      "id": 3,
      "prefix": "DOM",
      "paths": ["webapp/services/", "webapp/shared/", "webapp/schemas/"]
    },
    "devops": {
      "branch": "layers/devops",
      "role": "Cadre IA, infrastructure, configuration et scripts",
      "id": 4,
      "prefix": "OPS",
      "paths": [
        "codebase-integrity/",
        "infra/",
        "docs/",
        "dev-book/",
        "webapp/scripts/"
      ]
    },
    "dashboard": {
      "branch": "layers/dashboard",
      "role": "Frontend et tests dédiés du dashboard",
      "id": 5,
      "prefix": "DASH",
      "paths": [
        "webapp/dashboard/",
        "webapp/tests/e2e/saas-access.spec.ts",
        "webapp/tests/e2e/saas-editor.spec.ts",
        "webapp/tests/layers/dashboard.vitest.ts"
      ],
      "devComposeFile": "infra/docker/docker-compose.dashboard-dev.yml",
      "devServices": [
        "webapp-localhost",
        "nginx"
      ]
    }
  },
  "defaultLayer": "devops",
  "requireBasePaths": [
    "webapp/package.json",
    "infra/config/layers.json",
    "AGENTS.md"
  ]
}
