# Commandes du cadre ; aucun service ni worktree créé implicitement.
export LAYER BASE HEAD IMAGE
export AIDE_REPO := $(CURDIR)

# Un seul verbe et au plus un argument positionnel ; aucune règle attrape-tout.
aide_actions := $(filter lane-up lane-down lane-logs lane-rebuild lane-status demands tasks,$(MAKECMDGOALS))
ifneq ($(strip $(aide_actions)),)
ifneq ($(words $(aide_actions)),1)
$(error Choisir une seule commande de lane ou de consultation)
endif
aide_operand := $(filter-out $(aide_actions),$(MAKECMDGOALS))
ifneq ($(filter-out 0 1,$(words $(aide_operand))),)
$(error Une seule couche ou demande est permise)
endif
ifneq ($(strip $(aide_operand)),)
ifneq ($(strip $(LAYER)),)
$(error Ne pas combiner argument positionnel et LAYER)
endif
ifneq ($(filter lane-up lane-down lane-logs lane-rebuild lane-status,$(aide_actions)),)
aide_layers := $(shell python3 -c 'import json; print(" ".join(json.load(open("infra/config/layers.json"))["layers"]))')
ifeq ($(filter $(aide_layers),$(aide_operand)),)
$(error Couche inconnue ; consulter infra/config/layers.json)
endif
else ifeq ($(aide_actions),tasks)
aide_number := $(patsubst DEM-%,%,$(aide_operand))
aide_nondigits := $(subst 9,,$(subst 8,,$(subst 7,,$(subst 6,,$(subst 5,,$(subst 4,,$(subst 3,,$(subst 2,,$(subst 1,,$(subst 0,,$(aide_number)))))))))))
ifneq ($(aide_nondigits),)
$(error Identifiant de demande invalide ; exemple : DEM-005)
endif
ifeq ($(filter DEM-%,$(aide_operand)),)
$(error Demande attendue : make tasks DEM-005)
endif
endif
ifeq ($(aide_actions),demands)
$(error make demands ne prend pas d'argument)
endif
.PHONY: $(aide_operand)
$(aide_operand):
	@:
endif
export AIDE_OPERAND := $(aide_operand)
endif
.PHONY: worktree-add worktree-list lane-env lane-check lane-setup lane-up lane-down aide-check contribution-check

worktree-add:
	@test -n "$${LAYER}" -a -n "$${BASE}" || { echo 'LAYER et BASE explicites requis'; exit 1; }
	python3 codebase-integrity/domaines/construction-livraison/scripts/worktrees.py add --layer "$${LAYER}" --branch "layers/$${LAYER}" --base "$${BASE}"

worktree-list:
	python3 codebase-integrity/domaines/construction-livraison/scripts/worktrees.py list

lane-env:
	python3 codebase-integrity/domaines/construction-livraison/scripts/environment.py prepare --layer "$${LAYER}"

lane-check:
	python3 codebase-integrity/domaines/construction-livraison/scripts/environment.py validate --layer "$${LAYER}"

lane-setup: lane-check
	$(DOCKER_RUN) bun run setup:local

lane-up:
	@python3 -B infra/scripts/lanes.py up

lane-down:
	@python3 -B infra/scripts/lanes.py down

.PHONY: lane-logs lane-rebuild lane-status demands tasks
lane-logs:
	@python3 -B infra/scripts/lanes.py logs

lane-rebuild:
	@python3 -B infra/scripts/lanes.py rebuild

lane-status:
	@python3 -B infra/scripts/lanes.py status

demands:
	@python3 -B infra/scripts/demand_status.py demands

tasks:
	@python3 -B infra/scripts/demand_status.py tasks

aide-check:
	python3 codebase-integrity/domaines/fiabilite-verifications/scripts/check_registry.py
	python3 codebase-integrity/domaines/construction-livraison/scripts/check_demands.py
	python3 codebase-integrity/domaines/fiabilite-verifications/scripts/check_docs.py
	python3 -B codebase-integrity/commun/test_domains.py

contribution-check:
	@test -n "$${BASE}" || { echo 'BASE explicite requise'; exit 1; }
	python3 codebase-integrity/domaines/construction-livraison/scripts/contribution.py --repo "$${AIDE_REPO}" --base "$${BASE}" --head "$${HEAD:-HEAD}"

.PHONY: aide-runtime-check
aide-runtime-check:
	@test -n "$${IMAGE}" || { echo 'IMAGE locale existante requise'; exit 1; }
	python3 codebase-integrity/domaines/construction-livraison/scripts/check_runtime.py --image "$${IMAGE}"

.PHONY: integrity-domains
integrity-domains:
	python3 codebase-integrity/domaines/fiabilite-verifications/scripts/check_registry.py --list
