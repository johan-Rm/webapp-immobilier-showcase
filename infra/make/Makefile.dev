# Serveur de fixtures explicite : construction SSR et service dans le même conteneur.
WEBAPP_TEST_PORT ?= 19856
CHECKS_FIXTURE_TARGET = $(if $(GD_TARGET),$(GD_TARGET),showcase-immobilier)
CHECKS_FIXTURE_NAME = $(notdir $(CURDIR))-checks-fixture-$(CHECKS_FIXTURE_TARGET)
.PHONY: test-up checks-fixture-start checks-fixture-stop
test-up:
	@$(CHECKS_DOCKER) info --format '{{.ServerVersion}}' >/dev/null
	@$(MAKE) --no-print-directory checks-prepare
	@$(MAKE) --no-print-directory _lane-test-up

checks-fixture-start: _lane-test-up

_lane-test-up:
	@case "$(CHECKS_FIXTURE_TARGET)" in showcase-immobilier|client2-immobilier|dashboard) ;; *) echo "Cible de fixtures inconnue"; exit 2 ;; esac
	@python3 -c 'import socket,sys; port=int(sys.argv[1]); 1024 <= port <= 65535 or sys.exit(2); s=socket.socket(); s.bind(("127.0.0.1",port)); s.close()' "$(WEBAPP_TEST_PORT)" 2>/dev/null || { echo "Port local invalide ou indisponible : $(WEBAPP_TEST_PORT). Aucun conteneur lancé."; exit 2; }
	@mkdir -p webapp/.tmp/quality/console-tmp
	@image=$$($(CHECKS_COMPOSE) config --format json | python3 -c 'import sys,json; c=json.load(sys.stdin); print(c["services"]["verify"].get("image") or c["name"]+"-verify")') || exit 2; \
	  $(CHECKS_DOCKER) image inspect "$$image" >/dev/null 2>&1 || { echo "Image absente : lancer make checks-prepare."; exit 2; }
	@$(CHECKS_INFO) "Démarrage de l’environnement de test — $(CHECKS_FIXTURE_TARGET)"
	@printf '%s\n' '  Image Docker des contrôles   Prête' '  Conteneur de test            Application Nuxt en mode SSR' '  Données de test              Catalogue et médias de démonstration' '  API de test                  Réponses simulées'
	@$(CHECKS_INFO) "Construction : webapp/.tmp/quality/browser-fixture-build-$(CHECKS_FIXTURE_TARGET).log"
	@$(CHECKS_COMPOSE) run --pull never --no-deps --rm --name "$(CHECKS_FIXTURE_NAME)" -e GD_TARGET="$(CHECKS_FIXTURE_TARGET)" -e WEBAPP_TEST_PORT="$(WEBAPP_TEST_PORT)" -e BROWSER_FIXTURES=1 -e MEDIA_FIXTURES=1 app-test

checks-fixture-stop: _lane-test-down

_lane-test-down:
	@case "$(CHECKS_FIXTURE_TARGET)" in showcase-immobilier|client2-immobilier|dashboard) ;; *) echo "Cible de fixtures inconnue"; exit 2 ;; esac
	@$(CHECKS_INFO) "INFO — Arrête uniquement le conteneur de fixtures $(CHECKS_FIXTURE_NAME)."
	@$(CHECKS_DOCKER) stop --timeout 15 "$(CHECKS_FIXTURE_NAME)"

.PHONY: _lane-test-up _lane-test-down _lane-test-logs _lane-test-status
_lane-test-logs:
	@$(CHECKS_DOCKER) logs --follow --tail 200 "$(CHECKS_FIXTURE_NAME)"

_lane-test-status:
	@$(CHECKS_DOCKER) ps --all --filter "name=^/$(CHECKS_FIXTURE_NAME)$$" --format 'table {{.Names}}\t{{.Status}}'

.PHONY: conventions-tests-types-placement _output-conventions-tests-types-placement
conventions-tests-types-placement:
	@python3 -B codebase-integrity/commun/check_presentation.py conventions-tests-types-placement -- $(MAKE) --no-print-directory _output-conventions-tests-types-placement

_output-conventions-tests-types-placement:
