GIT_COMMON_DIR := $(shell git rev-parse --path-format=absolute --git-common-dir)
COMPOSE_FILE := infra/docker/docker-compose.dev.yml
DOCKER_RUN := docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) run --rm webapp-localhost
PLAYWRIGHT_RUN := docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) --profile e2e up $(if $(BUILD),--build) --abort-on-container-exit --exit-code-from playwright playwright

export DOCKER_UID := $(shell id -u)
export DOCKER_GID := $(shell id -g)

.PHONY: dev-env
.PHONY: dev-webapp-localhost dev-webapp-ssr dev-nginx
.PHONY: dev-build dev-build-no-cache
.PHONY: dev-build-localhost dev-build-localhost-no-cache
.PHONY: dev-build-ssr dev-build-ssr-no-cache
.PHONY: dev-down dev-logs
.PHONY: dev-shell-webapp-localhost dev-shell-webapp-ssr dev-shell-nginx
.PHONY: dev-analyze dev-analyse
.PHONY: dev-playwright dev-playwright-report
.PHONY: third-party-tests-lint quality-lint-fix third-party-tests-format third-party-tests-types
.PHONY: frontend-conventions-check quality-generate-schemas
.PHONY: dev-content-sync dev-content-sync-dry

dev-env:
	@test -f webapp/.env || cp webapp/.env.example webapp/.env

dev-webapp-localhost: dev-env
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) up webapp-localhost

dev-webapp-ssr: dev-env
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) up $(if $(BUILD),--build) webapp-ssr client2-ssr nginx

dev-nginx: dev-env
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) up nginx

dev-build:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) build $(if $(NO_CACHE),--no-cache)

dev-build-no-cache:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) build --no-cache

dev-build-localhost:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) build webapp-localhost

dev-build-localhost-no-cache:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) build --no-cache webapp-localhost

dev-build-ssr:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) build webapp-ssr client2-ssr

dev-build-ssr-no-cache:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) build --no-cache webapp-ssr client2-ssr

dev-down:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) down

dev-logs:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) logs -f --tail=200

dev-shell-webapp-localhost:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) exec webapp-localhost sh

dev-shell-webapp-ssr:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) exec webapp-ssr sh

dev-shell-nginx:
	docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) exec nginx sh

dev-analyze:
	cd webapp && bunx nuxi analyze

dev-analyse: dev-analyze

.PHONY: third-party-tests-sonar-preview third-party-tests-sonar
third-party-tests-sonar-preview:
	@python3 webapp/scripts/quality/sonar_scope.py

third-party-tests-sonar:
	@if test -n "$${SONAR_SCANNER_HOME:-}" || test -n "$${GITHUB_EVENT_NAME:-}"; then \
	  python3 -B webapp/scripts/quality/sonar_run.py; \
	else \
	  bash webapp/scripts/quality/manual_sonar_cloud.sh; \
	fi

dev-playwright: dev-env
	@mkdir -p webapp/.tmp/playwright
	$(PLAYWRIGHT_RUN)

dev-playwright-report:
	cd webapp && bun run test:e2e:report

quality-lint-fix:
	$(DOCKER_RUN) bun run lint:fix



quality-generate-schemas:
	$(DOCKER_RUN) bun run scripts/run-schema-hook.mjs

_output-conventions-tests-frontend:
	@bun codebase-integrity/domaines/qualite-code/scripts/verify-frontend-conventions.ts


dev-content-sync:
	$(DOCKER_RUN) bun scripts/content-sync.ts

dev-content-sync-dry:
	$(DOCKER_RUN) bun scripts/content-sync.ts --dry-run

.PHONY: maquette-html

maquette-html:
	cd webapp && bash scripts/build/maquette-statique.sh

.PHONY: generate-static

generate-static:
	cd webapp && STATIC_OUTPUT=true NODE_ENV=production bun run generate

.PHONY: export-maquette

# Exporte la maquette HTML autonome vers un dossier de livraison.
# Usage : make export-maquette DEST=/chemin/vers/le/dossier
DEST ?= exports/maquette-html

export-maquette:
	@test -n "$(DEST)" || { echo "DEST est requis : make export-maquette DEST=/chemin"; exit 1; }
	cd webapp && STATIC_OUTPUT=true NODE_ENV=production bun run generate
	@mkdir -p "$(DEST)"
	cp -r webapp/.output/public/. "$(DEST)"/
	cd webapp && bun scripts/build/maquette-html.ts "$(abspath $(DEST))"
	@echo "Variante des fiches, panneau de details ouvert"
	@cd webapp && bash scripts/build/variante-panneaux.sh "$(abspath $(DEST))"
	@echo "Variante des accueils, menu principal ouvert"
	@cd webapp && bash scripts/build/variante-menu.sh "$(abspath $(DEST))"
	@echo
	@echo "Maquette exportee : $(DEST)"
	@echo "Ouvrir : $(DEST)/fr/index.html"

.PHONY: dev-check-ssr

dev-check-ssr:
	@set -eu; \
	ssr_address="$$(docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) port nginx 80)"; \
	ssr_layer="$$(docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) exec -T nginx printenv AIDE_LAYER)"; \
	python3 infra/scripts/check-local-ssr.py --port "$${ssr_address##*:}" --layer "$${ssr_layer}"

# Extension SaaS locale : conserve les commandes historiques à deux sites.
DASHBOARD_COMPOSE := docker compose --project-directory . --env-file webapp/.env -f $(COMPOSE_FILE) -f infra/docker/docker-compose.dashboard.yml
.PHONY: dev-dashboard-ssr dev-build-dashboard-ssr dev-check-dashboard-ssr

dev-dashboard-ssr: dev-env
	python3 infra/scripts/saas_projection_path.py
	$(DASHBOARD_COMPOSE) up $(if $(BUILD),--build) webapp-ssr client2-ssr dashboard-ssr nginx

dev-build-dashboard-ssr:
	$(DASHBOARD_COMPOSE) build dashboard-ssr

dev-check-dashboard-ssr:
	@set -eu; \
	ssr_address="$$( $(DASHBOARD_COMPOSE) port nginx 80 )"; \
	ssr_layer="$$( $(DASHBOARD_COMPOSE) exec -T nginx printenv AIDE_LAYER )"; \
	python3 infra/scripts/check-local-ssr.py --port "$${ssr_address##*:}" --layer "$${ssr_layer}" --dashboard

.PHONY: dev-saas-project-prepare dev-build-saas-projector dev-saas-project-dry dev-saas-project dev-saas-project-watch

dev-saas-project-prepare:
	python3 infra/scripts/saas_projection_path.py --prepare

dev-build-saas-projector:
	$(DASHBOARD_COMPOSE) build saas-projector

# Le dry-run natif ne crée aucun dossier ; aucun service n’est démarré.
dev-saas-project-dry:
	cd webapp && bun --no-env-file scripts/saas/project.ts --dry-run

dev-saas-project:
	python3 infra/scripts/saas_projection_path.py
	$(DASHBOARD_COMPOSE) run --rm --no-deps saas-projector bun --no-env-file scripts/saas/project.ts --once

dev-saas-project-watch:
	python3 infra/scripts/saas_projection_path.py
	$(DASHBOARD_COMPOSE) run --rm --no-deps saas-projector bun --no-env-file scripts/saas/project.ts --watch

# La préparation réutilise une image existante ; la reconstruction est explicite.
CHECKS_DOCKER ?= docker
CHECKS_COMPOSE = WEBAPP_BASE_URL="$(WEBAPP_BASE_URL)" CHECKS_REPO_ROOT="$(CURDIR)" CHECKS_GIT_COMMON_DIR="$(GIT_COMMON_DIR)" $(CHECKS_DOCKER) compose --project-directory . --env-file /dev/null -f infra/docker/docker-compose.test.yml --profile quality
CHECKS_INFO = python3 -c 'import os,sys; sys.path.insert(0,"codebase-integrity/commun"); from run_aide_checks import paint,supports_color; print(paint(sys.argv[1],"blue",supports_color(sys.stdout,os.environ)))'

.PHONY: checks-prepare checks-rebuild check
_output-checks-prepare:
	@image=$$($(CHECKS_COMPOSE) config --format json | python3 -c 'import sys,json; c=json.load(sys.stdin); print(c["services"]["verify"].get("image") or c["name"]+"-verify")') || exit 2; \
	  if $(CHECKS_DOCKER) image inspect "$$image" >/dev/null 2>&1; then \
	    $(CHECKS_INFO) "INFO — Image déjà prête : préparation ignorée, aucun build. Après modification des sources ou dépendances, lancer make checks-rebuild."; \
	  else \
	    $(MAKE) --no-print-directory checks-rebuild; \
	  fi

_output-checks-rebuild:
	@$(CHECKS_INFO) "INFO — Construit l’image des tests avec les sources et dépendances actuelles ; aucun serveur web démarré."
	@$(CHECKS_COMPOSE) build verify
	@$(CHECKS_INFO) "INFO — Image prête. Les commandes de contrôle peuvent maintenant la réutiliser sans reconstruction."

# Chaque commande exécute sa propre recette, même lors d’un appel Make multiple.
define run-control
	@$(CHECKS_INFO) "INFO — Utilise l’image existante, sans build ni téléchargement. Si elle manque, lancer make checks-prepare ; après modification des sources, lancer make checks-rebuild."
	@mkdir -p webapp/.tmp/quality/console-tmp
	@image=$$($(CHECKS_COMPOSE) config --format json | python3 -c 'import sys,json; c=json.load(sys.stdin); print(c["services"]["verify"].get("image") or c["name"]+"-verify")') || exit 2; \
	  $(CHECKS_DOCKER) image inspect "$$image" >/dev/null 2>&1 || { echo "Image des contrôles absente ou Docker indisponible : lancer make checks-prepare."; exit 2; }
	@$(CHECKS_COMPOSE) run --pull never --no-deps --rm verify $(1) --target $(if $(GD_TARGET),$(GD_TARGET),showcase-immobilier) $(if $(PROFILE),--profile $(PROFILE),)

endef

.PHONY: internal-tests-unit
_output-internal-tests-unit:
	$(call run-control,unit)

