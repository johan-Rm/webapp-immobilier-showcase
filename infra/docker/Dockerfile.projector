# syntax=docker/dockerfile:1.4
FROM oven/bun:1.4.0-alpine AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

FROM oven/bun:1.4.0-alpine AS projector
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies /app/node_modules/zod ./node_modules/zod
COPY shared ./shared
COPY scripts/saas/config.ts scripts/saas/contract.ts scripts/saas/project.ts \
     scripts/saas/projector.ts scripts/saas/storage.ts ./scripts/saas/
CMD ["bun", "--no-env-file", "scripts/saas/project.ts", "--watch"]
