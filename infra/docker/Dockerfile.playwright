FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e
RUN apt-get update \
    && apt-get install --yes --no-install-recommends make python3 \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global bun@1.4.0 lighthouse@13.0.1
COPY --from=grafana/k6:1.6.1@sha256:a5ad6bc089a08d77c3ec49f3db8c6fa7a148e4073efcac44c675dbaf3568d8e1 /usr/bin/k6 /usr/local/bin/k6
WORKDIR /workspace/webapp
COPY webapp/package.json webapp/bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts
WORKDIR /workspace/codebase-integrity
COPY codebase-integrity/package.json codebase-integrity/bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts
ARG CHECKS_UID=1000
ARG CHECKS_GID=1000
WORKDIR /workspace
COPY --chown=${CHECKS_UID}:${CHECKS_GID} webapp ./webapp
COPY --chown=${CHECKS_UID}:${CHECKS_GID} codebase-integrity ./codebase-integrity
COPY --chown=${CHECKS_UID}:${CHECKS_GID} infra ./infra
COPY --chown=${CHECKS_UID}:${CHECKS_GID} docs ./docs
COPY --chown=${CHECKS_UID}:${CHECKS_GID} dev-book ./dev-book
COPY --chown=${CHECKS_UID}:${CHECKS_GID} design ./design
COPY --chown=${CHECKS_UID}:${CHECKS_GID} .github ./.github
COPY --chown=${CHECKS_UID}:${CHECKS_GID} README.md AGENTS.md Makefile ./
RUN mkdir -p webapp/node_modules/.cache webapp/node_modules/.vite codebase-integrity/node_modules/.cache codebase-integrity/node_modules/.vite \
    && chown ${CHECKS_UID}:${CHECKS_GID} /workspace /workspace/webapp /workspace/codebase-integrity \
      webapp/node_modules/.cache webapp/node_modules/.vite codebase-integrity/node_modules/.cache codebase-integrity/node_modules/.vite
USER ${CHECKS_UID}:${CHECKS_GID}
WORKDIR /workspace/webapp
ENV CI=true
ENV HOME=/tmp
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
CMD ["bun", "--no-env-file", "run", "verify", "--", "unit"]

ENV CHROME_PATH=/ms-playwright/chromium-1234/chrome-linux64/chrome
