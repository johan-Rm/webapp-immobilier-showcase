# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea
localhost.*
lighthouse.*
lighthouse*.json

# Local env files
.env
.env.*
!.env.example

# Nginx local certs
infra/nginx/certs/*
!infra/nginx/certs/.gitkeep

# Bun
.bun-cache

# Content généré par make content-sync
webapp/content/*/accommodations/
webapp/content/*/metadata/category-code.yaml
webapp/content/*/metadata/media-object.yaml

# Nuxt 4 ref
nuxt-4-reference

# Git worktrees
.worktrees/

# Generated/public assets
webapp/public/images/
lighthouse-*
!webapp/scripts/lighthouse-*.sh
firefox.*
.tmp/playwright/

# Bootstrap state
webapp/scripts/bootstrap-data/.state

# Artefacts de build temporaires (maquette HTML)
.tmp

# Contrats générés ; les sources YAML restent versionnées
webapp/schemas/interfaces/
webapp/schemas/dtos/

# Couches AIDE (le guide reste versionné)
/worktree/*
!/worktree/README.md
__pycache__/
*.pyc

# Client-specific runtime data and media
webapp/sites/*/public/images/
webapp/sites/*/content/*/accommodations/
webapp/sites/*/content/*/metadata/category-code.yaml
webapp/sites/*/content/*/metadata/media-object.yaml

/tmp/
